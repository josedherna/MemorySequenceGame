<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="rootVbox" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.jhproject.memorysequencegame.SelectionController">
    <HBox fx:id="headerHbox" alignment="CENTER" maxHeight="170.0" prefHeight="120.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
        <Label fx:id="headerLabel" text="Select a Difficulty">
           <font>
               <Font size="40.0" />
           </font>
        </Label>
    </HBox>
   <HBox maxHeight="100.0" minHeight="30.0" prefHeight="30.0" prefWidth="200.0" VBox.vgrow="ALWAYS" />
   <VBox alignment="TOP_CENTER" prefHeight="200.0" prefWidth="100.0" spacing="20.0" VBox.vgrow="ALWAYS">
      <padding>
         <Insets left="40.0" right="40.0"/>
      </padding>
      <VBox fx:id="buttonVbox" alignment="CENTER" maxHeight="500.0" maxWidth="500.0" prefHeight="200.0"
            prefWidth="100.0" VBox.vgrow="ALWAYS">
         <HBox maxHeight="100.0" maxWidth="500.0" minHeight="25.0" prefHeight="40.0" prefWidth="200.0"/>
         <VBox alignment="TOP_CENTER" maxHeight="500.0" maxWidth="500.0" minHeight="150.0" prefHeight="150.0"
               prefWidth="100.0" VBox.vgrow="ALWAYS">
            <padding>
               <Insets left="40.0" right="40.0"/>
            </padding>
            <GridPane maxHeight="1.7976931348623157E308" maxWidth="400.0" vgap="8.0" VBox.vgrow="ALWAYS">
               <columnConstraints>
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
               </rowConstraints>
               <Button fx:id="easyButton" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                       mnemonicParsing="false" onAction="#displayEasyGame" text="Easy"
                       GridPane.halignment="CENTER"/>
               <Button fx:id="mediumButton" maxHeight="1.7976931348623157E308"
                       maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#displayMediumGame"
                       text="Medium" GridPane.halignment="CENTER" GridPane.rowIndex="1"/>
               <Button fx:id="hardButton" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                       mnemonicParsing="false" onAction="#displayHardGame" text="Hard"
                       GridPane.halignment="CENTER" GridPane.rowIndex="2"/>
            </GridPane>
         </VBox>
         <HBox maxHeight="100.0" maxWidth="500.0" minHeight="25.0" prefHeight="40.0" prefWidth="200.0"/>
      </VBox>
      <HBox fx:id="settingsHbox" alignment="CENTER" maxHeight="100.0" maxWidth="500.0" minHeight="44.0"
            prefHeight="45.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
         <padding>
            <Insets left="40.0" right="40.0"/>
         </padding>
         <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
            <padding>
               <Insets left="20.0" right="20.0"/>
            </padding>
            <GridPane maxHeight="320.0" maxWidth="200.0" minHeight="44.0" prefHeight="44.0" prefWidth="124.0"
                      VBox.vgrow="ALWAYS">
               <columnConstraints>
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
               </rowConstraints>
               <Button fx:id="settingsButton" maxHeight="102.0" maxWidth="1.7976931348623157E308"
                       mnemonicParsing="false" prefHeight="40.0" text="Settings" GridPane.halignment="CENTER"/>
            </GridPane>
         </VBox>
      </HBox>
   </VBox>
   <HBox maxHeight="100.0" minHeight="31.0" prefHeight="31.0" prefWidth="200.0" VBox.vgrow="ALWAYS" />
</VBox>
